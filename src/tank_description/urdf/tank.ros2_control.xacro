<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <ros2_control name="tank" type="system">
        <!-- <hardware>
            <plugin>mock_components/GenericSystem</plugin>
            <param name="calculate_dynamics">true</param>
        </hardware> -->

        <hardware>
           <plugin>tank_hardware/TankHardwareInterface</plugin>
           <param name="left_wheel_name">left_back_wheel_joint</param>
           <param name="right_wheel_name">right_back_wheel_joint</param>
           <param name="loop_rate">200</param>
           <param name="device">/dev/ttyUSB0</param>
           <param name="baud_rate">115200</param>
           <param name="timeout_ms">200</param>
           <param name="enc_counts_per_rev">20</param>
        </hardware>


        <joint name="left_back_wheel_joint">
            <command_interface name="velocity"/>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>
        
        
            <joint name="right_back_wheel_joint">
            <command_interface name="velocity"/>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>
    </ros2_control>
</robot>