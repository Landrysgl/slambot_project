<xacro:macro name="bar_joint" params="link_name joint_name o_xyz o_rpy">
<joint name="${joint_name}" type="fixed">
  <origin xyz="${o_xyz}" rpy="${o_rpy}"/>
  <parent link="base_link"/>
  <child link="${link_name}"/>
</joint>
</xacro:macro>


</robot>