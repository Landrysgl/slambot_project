<?xml version="1.0" ?>
<robot name="tank_urdf" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="tank_description_share"
                  value="$(find tank_description)"/>

  <xacro:include filename="${tank_description_share}/urdf/common_properties.xacro"/>
  <xacro:include filename="${tank_description_share}/urdf/tank_urdf.gazebo"/>
  <xacro:include filename="${tank_description_share}/urdf/sensors.xacro"/>
  <xacro:include filename="${tank_description_share}/urdf/tank_gz.ros2_control.xacro"/>
  <!-- <xacro:include filename="${tank_description_share}/urdf/gz_plugins.xacro"/> -->

  <xacro:property name="wheel_mass" value="5"/> 
  <xacro:property name="wheel_radius" value="0.14"/> 
  <xacro:property name="wheel_length" value="0.08"/> 

  <xacro:property name="base_mass" value="23"/> 
  <xacro:property name="base_length" value="0.810"/> 
  <xacro:property name="base_width" value="0.350"/> 
  <xacro:property name="base_height" value="0.430"/> 

  <xacro:property name="bar_mass" value="0.2"/> 
  <xacro:property name="bar_radius" value="0.01"/> 
  <xacro:property name="bar_length" value="0.1"/> 
 


<link name="base_footprint"/>

<joint name="base_footprint_joint" type="fixed">
  <parent link="base_footprint"/>
  <child link="base_link"/>
  <origin xyz="0 0 0.292289" rpy="0 0 0"/>
</joint>


<link name="base_link">
  <visual>
    <origin xyz="0 -0.175 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://tank_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 -0.175 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://tank_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
  <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}" o_xyz="-0.000339224274209803 0.000414518587673 0.0023010948198566436" o_rpy="0 0 0"/>
</link>



<xacro:bar_link prefix="right_front" visual_xyz="0 ${bar_length/2} 0" visual_rpy="${pi/2} 0 0"/>
<xacro:bar_link prefix="right_middle" visual_xyz="0 ${bar_length/2} 0" visual_rpy="${pi/2} 0 0"/>
<xacro:bar_link prefix="right_back" visual_xyz="0 ${bar_length/2} 0" visual_rpy="${pi/2} 0 0"/>
<xacro:bar_link prefix="left_front" visual_xyz="0 -${bar_length/2} 0" visual_rpy="${pi/2} 0 0"/>
<xacro:bar_link prefix="left_middle" visual_xyz="0 -${bar_length/2} 0" visual_rpy="${pi/2} 0 0"/>
<xacro:bar_link prefix="left_back" visual_xyz="0 -${bar_length/2} 0" visual_rpy="${pi/2} 0 0"/>



<xacro:wheel_link prefix="right_front" visual_xyz="0 0 0" visual_rpy="${pi/2} 0 0"/>
<xacro:wheel_link prefix="right_middle" visual_xyz="0 0 0" visual_rpy="${pi/2} 0 0"/>
<xacro:wheel_link prefix="right_back" visual_xyz="0 0 0" visual_rpy="${pi/2} 0 0"/>
<xacro:wheel_link prefix="left_front" visual_xyz="0 0 0" visual_rpy="${pi/2} 0 0"/>
<xacro:wheel_link prefix="left_middle" visual_xyz="0 0 0" visual_rpy="${pi/2} 0 0"/>
<xacro:wheel_link prefix="left_back" visual_xyz="0 0 0" visual_rpy="${pi/2} 0 0"/>



<xacro:bar_joint link_name="right_front_bar_link" joint_name="right_front_bar_joint"  o_xyz="0.265 0.195 -0.151226" o_rpy="0 0 0"/>
<xacro:bar_joint link_name="right_middle_bar_link" joint_name="right_middle_bar_joint"  o_xyz="0.0 0.195 -0.151226" o_rpy="0 0 0"/>
<xacro:bar_joint link_name="right_back_bar_link" joint_name="right_back_bar_joint"  o_xyz="-0.265 0.195 -0.151226" o_rpy="0 0 0"/>
<xacro:bar_joint link_name="left_front_bar_link" joint_name="left_front_bar_joint"  o_xyz="0.265 -0.195 -0.151226" o_rpy="0 0 0"/>
<xacro:bar_joint link_name="left_middle_bar_link" joint_name="left_middle_bar_joint"  o_xyz="0.0 -0.195 -0.151226" o_rpy="0 0 0"/>
<xacro:bar_joint link_name="left_back_bar_link" joint_name="left_back_bar_joint"  o_xyz="-0.265 -0.195 -0.151226" o_rpy="0 0 0"/>



<xacro:wheel_fixed_joint link_name="right_front_wheel_link" joint_name="right_front_wheel_joint"  o_xyz="0.265 ${0.195 + bar_length} -0.151226" o_rpy="0 0 0"/>
<xacro:wheel_fixed_joint link_name="right_middle_wheel_link" joint_name="right_middle_wheel_joint"  o_xyz="0.0 ${0.195 + bar_length} -0.151226" o_rpy="0 0 0"/>
<xacro:wheel_continuous_joint link_name="right_back_wheel_link" joint_name="right_back_wheel_joint"  o_xyz="-0.265 ${0.195 + bar_length} -0.151226" o_rpy="0 0 0"/>
<xacro:wheel_fixed_joint link_name="left_front_wheel_link" joint_name="left_front_wheel_joint"  o_xyz="0.265 -${0.195 + bar_length} -0.151226" o_rpy="0 0 0"/>
<xacro:wheel_fixed_joint link_name="left_middle_wheel_link" joint_name="left_middle_wheel_joint"  o_xyz="0.0 -${0.195 + bar_length} -0.151226" o_rpy="0 0 0"/>
<xacro:wheel_continuous_joint link_name="left_back_wheel_link" joint_name="left_back_wheel_joint"  o_xyz="-0.265 -${0.195 + bar_length} -0.151226" o_rpy="0 0 0"/>



<!-- <xacro:wheel_fixed_joint link_name="right_front_wheel_link" joint_name="right_front_wheel_joint" parent_joint_name="right_front_bar_joint" o_xyz="0 ${bar_length} 0" o_rpy="0 0 0"/>
<xacro:wheel_fixed_joint link_name="right_middle_wheel_link" joint_name="right_middle_wheel_joint" parent_joint_name="right_middle_bar_joint" o_xyz="0 ${bar_length} 0" o_rpy="0 0 0"/>
<xacro:wheel_continuous_joint link_name="right_back_wheel_link" joint_name="right_back_wheel_joint" parent_joint_name="right_back_bar_joint" o_xyz="0 ${bar_length} 0" o_rpy="0 0 0"/>
<xacro:wheel_fixed_joint link_name="left_front_wheel_link" joint_name="left_front_wheel_joint" parent_joint_name="left_front_bar_joint" o_xyz="0 -${bar_length} 0" o_rpy="0 0 0"/>
<xacro:wheel_fixed_joint link_name="left_middle_wheel_link" joint_name="left_middle_wheel_joint" parent_joint_name="left_middle_bar_joint" o_xyz="0 -${bar_length} 0" o_rpy="0 0 0"/>
<xacro:wheel_continuous_joint link_name="left_back_wheel_link" joint_name="left_back_wheel_joint" parent_joint_name="left_back_bar_joint" o_xyz="0 -${bar_length} 0" o_rpy="0 0 0"/> -->
</robot>
