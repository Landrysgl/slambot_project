<launch>

     <!-- Chemin vers le package -->
   <let name="tank_description_share"
       value="$(find-pkg-share tank_description)" />

   <let name="tank_bringup_share"
       value="$(find-pkg-share tank_bringup)" />

  <!-- Chemin complet vers l'URDF -->
   <let name="urdf_path"
       value="$(var tank_description_share)/urdf/tank_urdf.xacro" />

  <let name="rviz_config_file_path" 
       value="$(var tank_description_share)/rviz/slam_config.rviz"/>
       
       

   <node pkg="robot_state_publisher" exec="robot_state_publisher">
   <param name="robot_description" value="$(command 'xacro $(var urdf_path)')"/>
   </node>

    <node pkg="controller_manager" exec="ros2_control_node">
    <param from="$(var tank_bringup_share)/config/tank_controllers.yaml"/>
    </node>

    <node pkg="controller_manager" exec="spawner" args="joint_state_broadcaster"/>

    <node pkg="controller_manager" exec="spawner" args="diff_drive_controller"/>

    <!-- <node pkg="controller_manager" exec="spawner" args="gps_sensor_broadcaster"/>

    <node pkg="controller_manager" exec="spawner" args="imu_sensor_broadcaster"/> -->

    <node pkg="joy" exec="joy_node" name="primary_joy">
    <remap from="joy" to="/commands2"/>
    <param from="$(var tank_bringup_share)/config/joy2.yaml"/>
    </node>

    <node pkg="teleop_twist_joy" exec="teleop_node" name="teleop_twist_joy_2">
    <remap from="joy" to="/commands2"/>
    <remap from="/cmd_vel" to="/cmd_vel2"/>
    <param from="$(var tank_bringup_share)/config/joy2.yaml"/>
    </node>

     <node pkg="teleop_twist_joy" exec="teleop_node" name="teleop_twist_joy">
    <remap from="joy" to="/commands1"/>
    <remap from="/cmd_vel" to="/cmd_vel1"/>
    <param from="$(var tank_bringup_share)/config/joy1.yaml"/>
    </node>

